# PostgreSQL connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/product_os?schema=public"
PORT=3000

# Required for local email/password JWTs. Generate a unique secret of 32+ characters.
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters"

# Microsoft Entra ID (single-tenant app registration)
ENTRA_TENANT_ID="your-tenant-guid"
ENTRA_CLIENT_ID="your-api-app-client-id"

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS="http://localhost:3001"

# Docker Compose PostgreSQL password (use a strong value outside local development)
POSTGRES_PASSWORD="change-this-local-password"

# Next.js browser API endpoint (baked into the web build)
NEXT_PUBLIC_API_URL="http://localhost:3000/api"

# Optional Microsoft Entra browser app settings (must match your app registration)
NEXT_PUBLIC_ENTRA_CLIENT_ID=
NEXT_PUBLIC_ENTRA_TENANT_ID=
NEXT_PUBLIC_ENTRA_API_SCOPE=
NEXT_PUBLIC_ENTRA_REDIRECT_URI=http://localhost:3001
